# GitHub repo that contains .github/workflows/build-apk.yml
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=figtoapk
# Fine-grained PAT: Actions read/write and Contents read/write (release assets)
GITHUB_ACTIONS_TOKEN=github_pat_xxx
# Create a Vercel Blob store and add its token in Vercel as BLOB_READ_WRITE_TOKEN
# Add FIGMA_TOKEN as a GitHub Actions repository secret for Figma link imports
